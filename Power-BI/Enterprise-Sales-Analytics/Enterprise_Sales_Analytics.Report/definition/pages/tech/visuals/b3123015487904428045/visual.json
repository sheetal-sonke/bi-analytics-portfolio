                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Row-level security is implemented, not just described. Two roles, both filtering dim_location rather than the facts, so one predicate on a six-row dimension propagates to all three fact tables and target attainment stays correct.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4e6272"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Regional Manager - West is static, for a one-click demo. Regional Manager (Dynamic) uses USERPRINCIPALNAME() against dim_security, so adding a manager is a data change rather than a model change.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4e6272"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In deployment, RLS is defined on the semantic model and every thin report over it inherits.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4e6272"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
