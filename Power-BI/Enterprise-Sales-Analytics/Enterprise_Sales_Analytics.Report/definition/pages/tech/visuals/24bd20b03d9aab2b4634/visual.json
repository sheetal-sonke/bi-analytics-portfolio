                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Five conformed dimensions and three facts held at three deliberately different grains."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_date   Date, Year, Quarter, MonthName, YearMonth. Marked as a date table."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_customer   Segment, Industry, State"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_product   Category, Subcategory, Tier"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_location   Region, State, City"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_salesperson   Salesperson, Role, home Location"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "dim_security   Hidden. Maps user to permitted regions for dynamic RLS."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "fact_sales   Transaction grain, fully additive, 33,497 rows"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "fact_sales_target   Month x Location. No product or customer key, so those slicers deliberately do not filter it."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "fact_inventory   Month x Product x Location snapshot. Semi-additive: every inventory measure collapses to the latest snapshot in filter context rather than summing months."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ten relationships, all single-direction dimension to fact. No bidirectional filtering: three facts sharing five dimensions is exactly the shape where it creates ambiguity."
                  }
                ]
              }
            ]
          }
        }
