              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This file is Import mode, so it opens on any machine with no workspace access. Data is loaded through Power Query and stored in the model.",
                    "textStyle": {
                      "color": "#4e6272"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The same model also runs on Microsoft Fabric as SM_ENTERPRISE_SALES_ANALYTICS in workspace WS_PROD, with the report as a thin report over a live connection. Data platform and BI analytics sit in separate workspaces, and business logic is defined once in a central semantic model rather than duplicated per report.",
                    "textStyle": {
                      "color": "#4e6272"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measure names and measure-table organisation are identical in both, so the same report binds to either. Import here is a portability decision, not the deployment pattern.",
                    "textStyle": {
                      "color": "#4e6272"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
