		sourceColumn: Placeholder

		annotation SummarizationSetBy = Automatic

	partition narrative_measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows({}, type table [Placeholder = text])
				in
				    Source

	annotation PBI_ResultType = Table

