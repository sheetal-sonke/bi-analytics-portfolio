	column MonthStart
		dataType: dateTime
		isHidden
		formatString: dd MMM yyyy
		lineageTag: 7916e07d-a4d4-4659-a9e1-8ed3e45bd734
		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column ProductKey
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 1835f7ac-41c4-439d-8c62-19d683247316
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = User

	column LocationKey
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 6f735995-1ce3-4fbe-8dca-d3e35a8d88e0
		summarizeBy: none
		sourceColumn: LocationKey

