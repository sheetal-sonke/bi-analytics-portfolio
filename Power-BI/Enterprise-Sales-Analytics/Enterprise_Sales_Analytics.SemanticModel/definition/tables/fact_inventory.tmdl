		annotation SummarizationSetBy = User

	partition fact_inventory = m
		mode: import
		source =
				let
				    Raw = Csv.Document(
				        File.Contents(DataFolder & "\fact_inventory.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				            {"YearMonthKey", Int64.Type},
				            {"MonthStart", type date},
				            {"ProductKey", Int64.Type},
				            {"LocationKey", Int64.Type},
				            {"UnitsOnHand", Int64.Type},
				            {"ReorderPoint", Int64.Type},
				            {"SafetyStock", Int64.Type},
				            {"InventoryValue", Currency.Type}
				    })
				in
				    Typed

	annotation PBI_ResultType = Table

