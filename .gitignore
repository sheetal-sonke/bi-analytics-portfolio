# Power BI temporary/cache files
*.pbit
*.tmp
*.bak
*.lock
~$*

# Windows / OS files
Thumbs.db
Desktop.ini

# IDE / editor
.vscode/
.idea/

# Python/cache if we add scripts later
__pycache__/
*.pyc
.venv/

# Local environment/config
.env

That's a good .gitignore already. Just append the three missing entries rather than replacing it:

powershell
Add-Content .gitignore @"

# Power BI project - machine-bound credential signature, regenerates on open
**/.pbi/localSettings.json

# Analysis Services model backup
*.abf

# macOS, since the host is a Mac
.DS_Store
"@